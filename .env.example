# Copy this file to ".env" and fill in your keys. The .env file is gitignored.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Business news feed — free key at https://www.marketaux.com
VITE_MARKETAUX_KEY=

# NYSE stock prices & charts — free key at https://www.alphavantage.co/support/#api-key
VITE_AV_KEY=

# Soccer betting odds (1X2) — free key at https://the-odds-api.com
VITE_ODDS_API_KEY=

# Soccer fixtures (used for PSL / fixtures views) — free key at https://dashboard.api-football.com
VITE_APIFOOTBALL_KEY=

# Supabase — used by the /sectors page (weekly JSE sector commentary).
# Kept server-side only (read in api/sectors.js via a Vercel serverless
# function), so these DO NOT need the VITE_ prefix. Names use the Next.js
# convention purely because that's what the Supabase docs generate for you.
# Get them from your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Copy this file to ".env" and fill in your keys. The .env file is gitignored.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Business news feed — free key at https://www.marketaux.com
VITE_MARKETAUX_KEY=

# NYSE stock prices & charts — free key at https://www.alphavantage.co/support/#api-key
VITE_AV_KEY=

# Supabase — used by the /sectors page (weekly JSE sector commentary).
# Kept server-side only (read in api/sectors.js via a Vercel serverless
# function), so these DO NOT need the VITE_ prefix. Names use the Next.js
# convention purely because that's what the Supabase docs generate for you.
# Get them from your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── AI Analyst (`/analyst` page) ────────────────────────────────────────────
# Server-side only. All read inside api/analyst.js on Vercel — the browser
# never sees any of these. Sign up + generate keys at the URLs below.

# Anthropic Claude — the model that writes the actual analysis prose.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# TwelveData — live stock quotes for JSE and NYSE tickers.
# Free tier: 800 API calls per day. Sign up at https://twelvedata.com
TWELVEDATA_API_KEY=

# Financial Modeling Prep — company profiles + recent news.
# Free tier: 250 API calls per day. Sign up at https://financialmodelingprep.com
FMP_API_KEY=

# (Optional) Override which Claude model /api/analyst uses. Leave blank to
# default to claude-3-5-sonnet-latest.
CLAUDE_MODEL=

# Alpha Vantage — free key at https://www.alphavantage.co/support
# Activates live NYSE quotes on the /nyse page.
VITE_AV_KEY=your_alpha_vantage_key_here

# Supabase — free project at https://supabase.com
# Powers sign-in and cross-device sync for Tasks, Cash Flow, Invoices,
# Inventory and your dashboard layout preferences.
# Project Settings → API → Project URL / anon public key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
